@startuml vibecoder_components
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Диаграмма компонентов — ИИ-агент (локальное представление: Vibecoder)

Container(api_gateway, "API-шлюз", "Nginx 1.25", "Единая точка входа: TLS 1.3, маршрутизация, проверка токена, rate limit, WebSocket")
Container(generation_service, "Сервис генерации материалов", "Python 3.12 / FastAPI, Celery, python-pptx, python-docx, WeasyPrint", "Генерация презентаций, КП, one-pager, постов по корпоративным шаблонам (асинхронные задания)")

Container_Boundary(agent_service, "ИИ-агент") {
    Component(agent_api_comp, "API агента", "FastAPI, WebSocket", "Эндпоинт диалога со стримингом ответа и эндпоинт /complete для сервиса генерации")
    Component(orchestrator_comp, "Оркестратор агента", "LangGraph", "Граф шагов: разобрать вопрос → выбрать инструменты → собрать контекст → сгенерировать ответ → проставить ссылки на источники")
    Component(prompt_comp, "Сборщик промптов", "Jinja2", "Шаблоны промптов, вставка найденных фрагментов и цитат, ограничение длины контекста")
    Component(retrieval_comp, "Инструмент поиска знаний", "httpx", "Вызывает поиск фрагментов в core_api с токеном пользователя, поэтому права проверяются в ядре")
    Component(market_tool_comp, "Инструмент рыночных показателей", "httpx", "Вызывает analytics_service за рыночными индикаторами")
    Component(llm_comp, "Шлюз языковых моделей", "openai SDK (OpenAI-совместимый API)", "Выбор провайдера (локальный llm_server или облачный llm_provider), резервное переключение, стриминг токенов")
    Component(memory_comp, "Память диалога", "redis-py", "Короткий контекст текущего диалога")
    Component(dialog_repo_comp, "Репозиторий диалогов", "SQLAlchemy 2.0 (async)", "История диалогов и шаблоны промптов в PostgreSQL (схема agent)")
}

Container(core_api, "Сервис базы знаний (ядро)", "Python 3.12 / FastAPI, SQLAlchemy 2.0", "Проекты, продукты, кейсы, документы, права; гибридный поиск фрагментов")
Container(analytics_service, "Сервис аналитики и инсайтов", "Python 3.12 / FastAPI, pandas", "Показатели, сопоставление проектов компании с рынком, рыночные индикаторы")
Container(llm_server, "Локальный LLM-сервер", "vLLM (Qwen2.5 / T-lite) + bge-m3, GPU", "Генерация и эмбеддинги внутри контура, OpenAI-совместимый API")
ContainerDb(cache, "Кэш и сессии", "Redis 7", "Кэш поиска, контекст диалогов агента, лимиты")
ContainerDb(database, "Реляционная СУБД", "PostgreSQL 16", "Диалоги, шаблоны промптов и основные данные платформы")
System_Ext(llm_provider, "Внешние ИИ-сервисы", "GigaChat API, YandexGPT API, Kandinsky. Облачная генерация (SaaS-режим; в закрытом контуре отключается)")

' № инт. 23
Rel(api_gateway, agent_api_comp, "Проксирует диалоги с агентом, стриминг", "HTTP/JSON, WebSocket, TCP 8002")
' № инт. 49
Rel(generation_service, agent_api_comp, "Запрашивает структуру и тексты слайдов", "HTTP/JSON, TCP 8002")

' внутр.
Rel(agent_api_comp, orchestrator_comp, "Передаёт вопрос пользователя или задание генерации", "Python Call")
' внутр.
Rel(orchestrator_comp, memory_comp, "Читает и обновляет контекст диалога", "Python Call")
' внутр.
Rel(orchestrator_comp, retrieval_comp, "Запрашивает фрагменты документов", "Python Call")
' внутр.
Rel(orchestrator_comp, market_tool_comp, "Запрашивает рыночные показатели", "Python Call")
' внутр.
Rel(orchestrator_comp, prompt_comp, "Собирает промпт из шаблона и контекста", "Python Call")
' внутр.
Rel(orchestrator_comp, llm_comp, "Генерирует ответ (поток токенов)", "Python Call")
' внутр.
Rel(orchestrator_comp, dialog_repo_comp, "Сохраняет вопрос, ответ и источники", "Python Call")
' внутр.
Rel(prompt_comp, dialog_repo_comp, "Читает шаблоны промптов", "Python Call")

' № инт. 43
Rel(retrieval_comp, core_api, "Ищет релевантные фрагменты с учётом прав (RAG)", "HTTP/JSON, TCP 8000")
' № инт. 44
Rel(market_tool_comp, analytics_service, "Запрашивает рыночные показатели (инструмент агента)", "HTTP/JSON, TCP 8004")
' № инт. 45
Rel(llm_comp, llm_server, "Генерирует ответ", "HTTP/JSON (OpenAI API), TCP 8100")
' № инт. 46
Rel(llm_comp, llm_provider, "Генерация в облачном режиме и как резерв", "HTTPS/REST")
' № инт. 47
Rel(memory_comp, cache, "Контекст диалога", "RESP/TCP, TCP 6379")
' № инт. 48
Rel(dialog_repo_comp, database, "История диалогов, шаблоны промптов", "SQL/TCP, TCP 5432")

@enduml
