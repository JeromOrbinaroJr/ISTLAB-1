@startuml analyst_containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Диаграмма контейнеров — ИИ-платформа базы знаний и маркетинга (локальное представление: Аналитик)

' === ПЕРСОНЫ ===
Person(marketer, "Маркетолог", "Ищет кейсы и данные, общается с ИИ-агентом, генерирует презентации, КП, one-pager и посты")
Person(marketing_head, "Руководитель маркетинга", "Согласует материалы, смотрит дашборды эффективности и рыночные дайджесты")
Person(analyst, "Аналитик рынка", "Подключает внешние источники, настраивает показатели, витрины и регламентные отчёты")

' === ВНЕШНИЕ СИСТЕМЫ ===
System_Ext(market_sources, "Источники рыночной аналитики", "TAdviser, Strategy Partners, Росстат API, СПАРК-Интерфакс, RSS отраслевых СМИ")
System_Ext(bi_platform, "BI-платформа", "Yandex DataLens / Apache Superset: ad-hoc дашборды поверх витрин")
System_Ext(crm_system, "CRM компании", "Битрикс24 / amoCRM: клиенты, сделки, кейсы внедрения")
System_Ext(notification_gateway, "Сервисы доставки уведомлений", "SMTP-сервер, Telegram Bot API / Яндекс Мессенджер, FCM / APNs")

System_Boundary(kb_platform, "ИИ-платформа базы знаний и маркетинга") {
  ' === АНАЛИТИК: контур данных (моя зона) ===
  Container(market_collector, "Сервис сбора рыночной аналитики (ETL)", "Python 3.12 / Apache Airflow, httpx, pandas", "По расписанию забирает рыночные данные, воронку CRM и события использования, извлекает показатели, грузит витрины и публикует отчёты рынка для индексации.")
  Container(analytics_service, "Сервис аналитики и инсайтов", "Python 3.12 / FastAPI, pandas", "Показатели, сопоставление проектов компании с рынком, дашборды, еженедельные дайджесты, выгрузки XLSX/PDF.")
  ContainerDb(dwh, "Аналитическое хранилище", "ClickHouse 24", "Витрины: рыночные показатели, использование базы знаний, эффективность материалов.")

  ' === VIBECODER: клиентские приложения ===
  Container(web_app, "Веб-приложение", "React 18 / TypeScript, Vite (SPA), Ant Design", "База знаний, поиск, чат с ИИ-агентом, генератор материалов, согласование, раздел аналитики (доступ по ролям).")
  Container(mobile_app, "Мобильное приложение", "React Native (Expo) / TypeScript", "Быстрый поиск кейсов, чат с агентом, просмотр и отправка материалов, согласование, push.")

  ' === BACKEND ===
  Container(core_api, "Сервис базы знаний (ядро)", "Python 3.12 / FastAPI, SQLAlchemy 2.0", "Проекты, продукты, кейсы, документы, права; гибридный поиск; согласование; уведомления.")
  Container(ingestion_service, "Сервис обработки документов", "Python 3.12 / Celery, Docling, Tesseract OCR", "Парсинг, OCR, нарезка на фрагменты, эмбеддинги и индексация, в том числе отчётов рынка.")

  ' === ТИМЛИД: инфраструктура ===
  Container(api_gateway, "API-шлюз", "Nginx 1.25", "Единая точка входа: TLS 1.3, маршрутизация, проверка токена, rate limit, WebSocket, приём запросов BI.")
  ContainerDb(database, "Реляционная СУБД", "PostgreSQL 16", "Пользователи, проекты, кейсы, метаданные документов, материалы.")
  ContainerQueue(message_broker, "Брокер сообщений", "RabbitMQ 3.13 (AMQP)", "События между сервисами и очереди Celery.")
  ContainerDb(object_storage, "Объектное хранилище", "MinIO (S3 API)", "Оригиналы документов, сгенерированные материалы, сырые отчёты рынка, файлы отчётов.")
  Container(llm_server, "Локальный LLM-сервер", "vLLM (Qwen2.5 / T-lite) + bge-m3, GPU", "Генерация и эмбеддинги внутри контура, OpenAI-совместимый API.")
}

' === СВЯЗИ: ЛЮДИ (стрелка = инициатор сессии) ===
' № инт. 1
Rel(marketer, web_app, "Запрашивает рыночную справку: поиск, чат с агентом, генерация и правка материалов", "HTTPS")
' № инт. 6
Rel(analyst, web_app, "Подключает источники, настраивает показатели и витрины", "HTTPS")
' № инт. 7
Rel(analyst, bi_platform, "Строит ad-hoc дашборды поверх витрин", "HTTPS")
' № инт. 3
Rel(marketing_head, web_app, "Согласует материалы, смотрит дашборды", "HTTPS")
' № инт. 4
Rel(marketing_head, mobile_app, "Согласует материалы и смотрит ключевые показатели с телефона", "iOS / Android")

' === СВЯЗИ: ДОСТАВКА УВЕДОМЛЕНИЙ ЛЮДЯМ ===
' № инт. 12
Rel(notification_gateway, marketing_head, "Запрос на согласование, дайджест рынка", "E-mail (SMTP)")
' № инт. 14
Rel(notification_gateway, analyst, "Сбой загрузки источника", "E-mail (SMTP)")

' === СВЯЗИ: ВХОД В ПЕРИМЕТР (наружу открыт только 443) ===
' № инт. 16
Rel(web_app, api_gateway, "REST-запросы, стриминг ответов агента", "HTTPS/JSON, WSS, TCP 443")
' № инт. 17
Rel(mobile_app, api_gateway, "REST-запросы, стриминг ответов агента", "HTTPS/JSON, WSS, TCP 443")
' № инт. 20
Rel(bi_platform, api_gateway, "Читает витрины (только чтение)", "SQL over HTTPS, TCP 443")

' === СВЯЗИ: ШЛЮЗ -> СЕРВИСЫ ===
' № инт. 22
Rel(api_gateway, core_api, "Проксирует запросы базы знаний, поиска, согласования, webhook", "HTTP/JSON, TCP 8000")
' № инт. 25
Rel(api_gateway, analytics_service, "Проксирует запросы дашбордов и отчётов", "HTTP/JSON, TCP 8004")
' № инт. 26
Rel(api_gateway, dwh, "Проксирует запросы BI (read-only пользователь)", "HTTP, TCP 8123")

' === СВЯЗИ: СОСЕДНИЕ СЕРВИСЫ ===
' № инт. 33
Rel(core_api, message_broker, "Публикует document.uploaded, usage.event; получает document.indexed, material.generated, report.ready", "AMQP, TCP 5672")
' № инт. 35
Rel(core_api, notification_gateway, "Отправляет письма, сообщения и push", "SMTP/TLS 465, HTTPS/REST")
' № инт. 37
Rel(ingestion_service, message_broker, "Получает document.uploaded, market.report.ingested; публикует document.indexed", "AMQP, TCP 5672")

' === СВЯЗИ: СБОР РЫНОЧНОЙ АНАЛИТИКИ (ETL) ===
' № инт. 54
Rel(market_collector, market_sources, "Забирает отчёты, рейтинги, новости, данные о компаниях", "HTTPS/REST, RSS")
' № инт. 55
Rel(market_collector, crm_system, "Выгружает воронку сделок", "HTTPS/REST")
' № инт. 56
Rel(market_collector, llm_server, "Извлекает показатели и суммирует отчёты", "HTTP/JSON, TCP 8100")
' № инт. 57
Rel(market_collector, object_storage, "Сохраняет сырые отчёты", "HTTPS (S3 API), TCP 9000")
' № инт. 58
Rel(market_collector, dwh, "Загружает данные и пересчитывает витрины", "HTTP, TCP 8123")
' № инт. 59
Rel(market_collector, message_broker, "Читает usage.event, material.generated; публикует market.report.ingested", "AMQP, TCP 5672")
' № инт. 60
Rel(market_collector, database, "Инкрементально выгружает проекты и кейсы", "SQL/TCP, TCP 5432")

' === СВЯЗИ: АНАЛИТИКА И ОТЧЁТЫ ===
' № инт. 61
Rel(analytics_service, dwh, "Аналитические запросы к витринам", "HTTP, TCP 8123")
' № инт. 62
Rel(analytics_service, object_storage, "Сохраняет файлы отчётов", "HTTPS (S3 API), TCP 9000")
' № инт. 63
Rel(analytics_service, message_broker, "Публикует report.ready", "AMQP, TCP 5672")
@enduml
