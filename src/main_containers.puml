Rel(mobile_app, api_gateway, "REST-запросы, стриминг ответов агента", "HTTPS/JSON, WSS, TCP 443")
' № инт. 18
Rel(crm_system, api_gateway, "Событие закрытия сделки (webhook)", "HTTPS/JSON, TCP 443")
' № инт. 19
Rel(payment_gateway, api_gateway, "Статус платежа (webhook)", "HTTPS/JSON, TCP 443")
' № инт. 20
Rel(bi_platform, api_gateway, "Чтение витрин (только чтение)", "SQL over HTTPS, TCP 443")

' === ШЛЮЗ -> СЕРВИСЫ ===
' № инт. 21
Rel(api_gateway, auth_service, "Вход (OIDC), проверка токена и ролей", "HTTP/OIDC, TCP 8081")
' № инт. 22
Rel(api_gateway, core_api, "Проксирует запросы базы знаний, поиска, согласования, webhook", "HTTP/JSON, TCP 8000")
