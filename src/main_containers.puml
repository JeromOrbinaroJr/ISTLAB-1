@startuml main_containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Диаграмма контейнеров — ИИ-платформа базы знаний и маркетинга (интеграционное представление)

' === ЕДИНЫЙ ПУЛ РОЛЕЙ ===
Person(marketer, "Маркетолог", "Ищет кейсы и данные, общается с ИИ-агентом, генерирует материалы")
Person(bd_manager, "Менеджер по развитию бизнеса", "Находит кейсы и отправляет материалы партнёрам с телефона")
Person(marketing_head, "Руководитель маркетинга", "Согласует материалы, смотрит дашборды и дайджесты")
Person(kb_editor, "Контент-менеджер базы знаний", "Загружает документы, ведёт карточки проектов и кейсов")
Person(analyst, "Аналитик рынка", "Подключает источники, настраивает показатели и витрины")
Person(platform_admin, "Администратор платформы", "Пользователи, роли, коннекторы, мониторинг")

' === ЕДИНЫЙ ПУЛ ВНЕШНИХ СИСТЕМ ===
System_Ext(doc_sources, "Корпоративные хранилища документов", "SMB, Nextcloud / Яндекс Диск, Confluence")
System_Ext(crm_system, "CRM компании", "Битрикс24 / amoCRM")
System_Ext(corporate_idp, "Корпоративный каталог пользователей", "Active Directory / FreeIPA")
System_Ext(llm_provider, "Внешние ИИ-сервисы", "GigaChat API, YandexGPT API, Kandinsky")
System_Ext(market_sources, "Источники рыночной аналитики", "TAdviser, Strategy Partners, Росстат API, СПАРК-Интерфакс, RSS")
System_Ext(bi_platform, "BI-платформа", "Yandex DataLens / Apache Superset")
System_Ext(notification_gateway, "Сервисы доставки уведомлений", "SMTP, Telegram Bot API / Яндекс Мессенджер, FCM / APNs")
System_Ext(payment_gateway, "Платёжный шлюз", "ЮKassa (рекуррентные платежи)")

System_Boundary(kb_platform, "ИИ-платформа базы знаний и маркетинга") {
  ' === VIBECODER: клиенты и ИИ-контур ===
  Container(web_app, "Веб-приложение", "React 18 / TypeScript, Vite (SPA), Ant Design", "База знаний, поиск, чат с ИИ-агентом, генератор и редактор материалов, согласование, админ-раздел (доступ по ролям).")
  Container(mobile_app, "Мобильное приложение", "React Native (Expo) / TypeScript", "Быстрый поиск кейсов, чат с агентом, просмотр и отправка материалов, согласование, push.")
  Container(agent_service, "ИИ-агент", "Python 3.12 / FastAPI, LangGraph", "Оркестрация RAG: поиск фрагментов, вызов инструментов, сборка промпта, стриминг ответа со ссылками на источники.")
  Container(generation_service, "Сервис генерации материалов", "Python 3.12 / FastAPI, Celery, python-pptx, python-docx, WeasyPrint", "Презентации, КП, one-pager, посты по корпоративным шаблонам (асинхронные задания).")

  ' === BACKEND: ядро, авторизация, индексация ===
  Container(auth_service, "Сервис авторизации", "Keycloak 24 (OIDC)", "SSO, федерация с AD по LDAP, выпуск и проверка JWT, роли и права на разделы.")
  Container(core_api, "Сервис базы знаний (ядро)", "Python 3.12 / FastAPI, SQLAlchemy 2.0", "Проекты, продукты, кейсы, документы, версии, права; гибридный поиск; согласование; CRM, уведомления, подписки.")
  Container(ingestion_service, "Сервис обработки документов", "Python 3.12 / Celery, Docling, Tesseract OCR", "Синхронизация хранилищ, парсинг, OCR, нарезка на фрагменты, эмбеддинги, индексация.")
  ContainerDb(vector_db, "Векторная БД", "Qdrant 1.x", "Эмбеддинги фрагментов документов с метаданными прав доступа.")

  ' === АНАЛИТИК: контур данных ===
  Container(market_collector, "Сервис сбора рыночной аналитики (ETL)", "Python 3.12 / Apache Airflow, httpx, pandas", "По расписанию забирает рыночные данные и события использования, извлекает показатели, грузит витрины.")
  Container(analytics_service, "Сервис аналитики и инсайтов", "Python 3.12 / FastAPI, pandas", "Показатели, сопоставление проектов с рынком, дашборды, дайджесты, выгрузки XLSX/PDF.")
  ContainerDb(dwh, "Аналитическое хранилище", "ClickHouse 24", "Витрины: рыночные показатели, использование базы знаний, эффективность материалов.")

  ' === ТИМЛИД: шлюз, хранилища, брокер, LLM, наблюдаемость ===
  Container(api_gateway, "API-шлюз", "Nginx 1.25", "Единая точка входа: TLS 1.3, маршрутизация, проверка токена, rate limit, WebSocket, приём webhook и запросов BI.")
  ContainerDb(database, "Реляционная СУБД", "PostgreSQL 16", "Пользователи, проекты, кейсы, метаданные документов, материалы, диалоги, подписки.")
  ContainerQueue(message_broker, "Брокер сообщений", "RabbitMQ 3.13 (AMQP)", "События между сервисами и очереди Celery.")
  ContainerDb(cache, "Кэш и сессии", "Redis 7", "Кэш поиска, контекст диалогов агента, лимиты.")
  ContainerDb(object_storage, "Объектное хранилище", "MinIO (S3 API)", "Оригиналы документов, шаблоны, сгенерированные материалы, сырые отчёты рынка.")
  Container(llm_server, "Локальный LLM-сервер", "vLLM (Qwen2.5 / T-lite) + bge-m3, GPU", "Генерация и эмбеддинги внутри контура, OpenAI-совместимый API.")
  Container(monitoring, "Система наблюдаемости", "Prometheus, Alertmanager, Grafana, Loki", "Метрики (в т.ч. GPU), логи, панели, оповещения.")
}

' === ЛЮДИ -> ПРИЛОЖЕНИЯ ===
' № инт. 1
Rel(marketer, web_app, "Поиск, чат с агентом, генерация и правка материалов", "HTTPS")
' № инт. 2
Rel(bd_manager, mobile_app, "Ищет кейсы, просматривает и отправляет материалы", "iOS / Android")
' № инт. 3
Rel(marketing_head, web_app, "Согласует материалы, смотрит дашборды", "HTTPS")
