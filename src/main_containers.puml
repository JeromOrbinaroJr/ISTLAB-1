Rel(ingestion_service, doc_sources, "Синхронизирует документы по расписанию", "SMB 3 / WebDAV (HTTPS), REST")
' № инт. 39
Rel(ingestion_service, object_storage, "Читает оригиналы, сохраняет извлечённый текст", "HTTPS (S3 API), TCP 9000")
' № инт. 40
Rel(ingestion_service, llm_server, "Получает эмбеддинги фрагментов", "HTTP/JSON, TCP 8100")
' № инт. 41
Rel(ingestion_service, vector_db, "Записывает векторы фрагментов", "gRPC, TCP 6334")
' № инт. 42
Rel(ingestion_service, database, "Статус индексации, метаданные документов", "SQL/TCP, TCP 5432")

' === VIBECODER: ИИ-АГЕНТ ===
' № инт. 43
Rel(agent_service, core_api, "Ищет релевантные фрагменты с учётом прав (RAG)", "HTTP/JSON, TCP 8000")
