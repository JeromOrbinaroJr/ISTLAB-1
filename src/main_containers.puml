' № инт. 28
Rel(auth_service, corporate_idp, "Федерация пользователей и групп", "LDAPS, TCP 636")

' === BACKEND: ЯДРО ===
' № инт. 29
Rel(core_api, database, "Проекты, кейсы, документы, права, материалы, подписки", "SQL/TCP, TCP 5432")
