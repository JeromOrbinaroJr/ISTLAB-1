@startuml analyst_landscape
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Диаграмма системного ландшафта (Level 0) — контур данных, локальное представление: Аналитик

Person(analyst, "Аналитик рынка", "Подключает источники рыночной аналитики, настраивает показатели и витрины, строит дашборды")
Person(marketing_head, "Руководитель маркетинга", "Согласует материалы, смотрит дашборды и еженедельный дайджест рынка")

Enterprise_Boundary(customer_it, "ИТ-инфраструктура компании-заказчика") {
    System(kb_platform, "ИИ-платформа базы знаний и маркетинга", "Проектируемая система: база знаний, ИИ-агент, генерация материалов, аналитика и инсайты")
    System_Ext(crm_system, "CRM компании", "Битрикс24 / amoCRM. Сделки, кейсы, воронка продаж")
    System_Ext(corporate_idp, "Корпоративный каталог пользователей (IAM)", "Active Directory / FreeIPA. Учётные записи и группы")
    System_Ext(bi_platform, "BI-платформа", "Yandex DataLens / Apache Superset. Дашборды аналитиков")
}

System_Ext(market_sources, "Источники рыночной аналитики", "TAdviser, Strategy Partners, Росстат, СПАРК, RSS")
System_Ext(payment_gateway, "Платёжный шлюз ЮKassa", "Приём платежей за подписку")
System_Ext(notification_gateway, "Сервисы доставки уведомлений", "SMTP-сервер, Telegram Bot API, FCM / APNs")

Rel(analyst, kb_platform, "Подключает источники, настраивает показатели и витрины", "HTTPS/JSON")
Rel(marketing_head, kb_platform, "Согласует материалы, смотрит дашборды и дайджест", "HTTPS/JSON")
Rel(analyst, bi_platform, "Строит ad-hoc дашборды", "HTTPS")

Rel(kb_platform, corporate_idp, "Проверяет учётные данные, синхронизирует группы (SSO через Keycloak)", "LDAPS, TCP 636 / OIDC (OAuth2)")
Rel(kb_platform, crm_system, "Запрашивает сделки и кейсы, прикрепляет КП к сделке", "HTTPS/REST")
Rel(crm_system, kb_platform, "Сообщает о закрытии сделки (webhook)", "HTTPS/JSON")
Rel(kb_platform, payment_gateway, "Создаёт платёж за подписку", "HTTPS/REST")
Rel(payment_gateway, kb_platform, "Сообщает статус платежа (webhook)", "HTTPS/JSON")
Rel(bi_platform, kb_platform, "Читает витрины данных (только чтение)", "SQL over HTTPS")
Rel(kb_platform, market_sources, "Забирает отчёты, рейтинги, новости", "HTTPS/REST, RSS")
Rel(kb_platform, notification_gateway, "Передаёт письма, сообщения и push", "SMTP/TLS 465, HTTPS/REST")

@enduml
