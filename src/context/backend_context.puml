@startuml backend_context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title Диаграмма системного контекста — ИИ-платформа базы знаний и маркетинга (локальное представление: Backend)

' === ПЕРСОНЫ (глобальные ID) ===
Person(kb_editor, "Контент-менеджер базы знаний", "Загружает документы, ведёт карточки проектов, продуктов и кейсов, следит за актуальностью данных")
Person(marketer, "Маркетолог", "Ищет документы, кейсы и факты о продуктах для подготовки материалов")
Person(platform_admin, "Администратор платформы", "Настраивает пользователей, роли, права доступа и коннекторы источников")

' === ПРОЕКТИРУЕМАЯ СИСТЕМА (чёрный ящик) ===
System(kb_platform, "ИИ-платформа базы знаний и маркетинга", "Единая корпоративная база знаний о продуктах, проектах и кейсах: загрузка и индексация документов, гибридный поиск с учётом прав, интеграция с CRM, ИИ-агент и генерация материалов")

' === ВНЕШНИЕ СИСТЕМЫ (глобальные ID) ===
System_Ext(doc_sources, "Корпоративные хранилища документов", "Файловые серверы (SMB), Nextcloud / Яндекс Диск, Confluence: исходные презентации, отчёты и документы проектов")
System_Ext(crm_system, "CRM компании", "Битрикс24 / amoCRM: клиенты, сделки, кейсы внедрения")
System_Ext(corporate_idp, "Корпоративный каталог пользователей", "Active Directory / FreeIPA: учётные записи и группы сотрудников")
System_Ext(payment_gateway, "Платёжный шлюз", "ЮKassa: рекуррентные платежи за SaaS-подписку")
System_Ext(notification_gateway, "Сервисы доставки уведомлений", "SMTP-сервер, Telegram Bot API / Яндекс Мессенджер, FCM / APNs")

' === СВЯЗИ: ПЕРСОНЫ (стрелка = инициатор сессии) ===
' № инт. 4
Rel(kb_editor, kb_platform, "Загружает документы, ведёт карточки проектов, продуктов и кейсов, подтверждает актуальность", "HTTPS/JSON")
' № инт. 1
Rel(marketer, kb_platform, "Ищет документы и кейсы полнотекстовым и семантическим поиском", "HTTPS/JSON, WSS")
' № инт. 6
Rel(platform_admin, kb_platform, "Настраивает коннекторы хранилищ и CRM, роли и права доступа к разделам", "HTTPS")

' === СВЯЗИ: ИСТОЧНИКИ ЗНАНИЙ ===
' № инт. 8
Rel(kb_platform, doc_sources, "Синхронизирует документы по расписанию", "SMB 3 / WebDAV (HTTPS), REST")
' № инт. 9
Rel(kb_platform, crm_system, "Запрашивает закрытые сделки и кейсы внедрения, прикрепляет КП к сделке", "HTTPS/REST")
' № инт. 10
Rel(crm_system, kb_platform, "Сообщает о закрытии сделки (webhook)", "HTTPS/JSON")

' === СВЯЗИ: ДОСТУП И ПОДПИСКА ===
' № инт. 11
Rel(kb_platform, corporate_idp, "Проверяет учётные данные, синхронизирует группы сотрудников", "LDAPS, TCP 636")
' № инт. 15
Rel(kb_platform, payment_gateway, "Создаёт платёж за подписку", "HTTPS/REST")
' № инт. 16
Rel(payment_gateway, kb_platform, "Сообщает статус платежа (webhook)", "HTTPS/JSON")

' === СВЯЗИ: УВЕДОМЛЕНИЯ ===
' № инт. 17
Rel(kb_platform, notification_gateway, "Передаёт письма и сообщения: документ проиндексирован, документ устарел", "SMTP/TLS, HTTPS/REST")
' № инт. 21
Rel(notification_gateway, kb_editor, "Доставляет напоминание актуализировать устаревший документ", "E-mail (SMTP)")

@enduml
